<script>
    // ======================== API Base ========================
    const API_BASE = 'http://127.0.0.1:8080/api/v1';

    /** 根据 ip/method 构造 fetch URL：本地管理的始终走 127.0.0.1；
     *  创建房间时如果填了远程 IP，则向该远程中继发请求 */
    function remoteApiUrl(path) {
        const ipInput = document.getElementById('new-room-ip');
        if (ipInput) {
            const remoteIp = ipInput.value.trim();
            if (remoteIp && remoteIp !== '127.0.0.1' && remoteIp !== '::1') {
                const wrapped = remoteIp.includes(':') ? ('[' + remoteIp + ']') : remoteIp;
                return 'http://' + wrapped + ':8080' + path;
            }
        }
        return API_BASE + path;
    }

    function apiLog(method, path, status, detail) {
        var d = detail || '';
        if (d.length > 100) d = d.substring(0, 100) + '...';
        addLog(method + ' ' + path + ' → ' + status + (d ? ' | ' + d : ''));
    }

    async function apiGet(path) {
        try {
            const res = await fetch(API_BASE + path);
            const data = await res.json();
            apiLog('GET', path, res.status);
            if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
            return data;
        } catch (e) {
            apiLog('GET', path, '失败', e.message);
            return null;
        }
    }

    async function apiPost(path, body) {
        try {
            const res = await fetch(API_BASE + path, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                const msg = (data.error && data.error.message) || res.statusText;
                apiLog('POST', path, res.status, msg);
                throw new Error(msg);
            }
            apiLog('POST', path, res.status, data.connectionCode || '成功');
            return data;
        } catch (e) {
            if (!e.message.includes('→')) {
                apiLog('POST', path, '失败', e.message);
            }
            showToast('请求失败: ' + e.message);
            return null;
        }
    }

    async function apiDelete(path) {
        try {
            const res = await fetch(API_BASE + path, { method: 'DELETE' });
            const data = await res.json().catch(() => ({}));
            apiLog('DELETE', path, res.status);
            if (!res.ok) throw new Error((data.error && data.error.message) || res.statusText);
            return data;
        } catch (e) {
            apiLog('DELETE', path, '失败', e.message);
            showToast('请求失败: ' + e.message);
            return null;
        }
    }

    // ======================== Data Layer (all from backend) ========================
    const CONFIG = {
        publicIp: '',
        relayIpv6: '',
        relayIpv4: '',
        relayConfigured: false,
        portPoolStart: 40000,
        portPoolEnd: 41000,
        controlPort: 40000,
        httpPort: 8080,
        heartbeatIntervalMs: 25000,
        roomGracePeriodMs: 45000,
        maxPlayersPerRoom: 10,
        version: '0.4.0',
        protocolVersion: 1,
        tlsVersion: 'TLS 1.3'
    };

    let relayRunning = false;
    let menuCounter = 0;

    // backend data (all default 0)
    let engineStats = {
        uptimeSeconds: 0, activeRooms: 0, totalRooms: 0,
        activeTunnels: 0, totalConnections: 0,
        portPoolUsed: 0, portPoolTotal: 1001, bytesRelayed: 0
    };
    let rooms = new Map();
    let eventLog = [];

    function formatBytes(b) {
        if (!b || b === 0) return '0 B';
        if (b < 1024) return b + ' B';
        if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
        if (b < 1073741824) return (b / 1048576).toFixed(1) + ' MB';
        return (b / 1073741824).toFixed(2) + ' GB';
    }

    function formatUptime(seconds) {
        const s = Math.max(0, Math.floor(seconds));
        const h = Math.floor(s / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    }

    // ======================== Backend Sync ========================
    async function fetchStats() {
        const data = await apiGet('/stats');
        if (data) {
            engineStats = {
                uptimeSeconds: data.uptimeSeconds || 0,
                activeRooms: data.activeRooms || 0,
                totalRooms: data.totalRooms || 0,
                activeTunnels: data.activeTunnels || 0,
                totalConnections: data.totalConnections || 0,
                portPoolUsed: data.portPoolUsed || 0,
                portPoolTotal: data.portPoolTotal || (CONFIG.portPoolEnd - CONFIG.portPoolStart + 1),
                bytesRelayed: data.bytesRelayed || 0
            };
            startTime = Date.now();
        }
    }

    async function fetchRooms() {
        const data = await apiGet('/rooms');
        if (data && data.rooms) {
            rooms.clear();
            data.rooms.forEach(r => {
                rooms.set(r.roomId, {
                    roomId: r.roomId,
                    roomName: r.roomName || '',
                    relayIp: CONFIG.publicIp,
                    connectionCode: r.connectionCode || '',
                    assignedPort: r.assignedPort || 0,
                    localMcPort: r.localMcPort || 0,
                    status: r.status || 'waiting',
                    playerCount: r.playerCount || 0,
                    createdAt: r.createdAt || '',
                    players: [],
                    tunnels: []
                });
            });
        }
    }

    async function fetchConfig() {
        const data = await apiGet('/config');
        if (data) {
            CONFIG.publicIp = data.publicIp || CONFIG.publicIp;
            CONFIG.portPoolStart = data.portPoolStart || CONFIG.portPoolStart;
            CONFIG.portPoolEnd = data.portPoolEnd || CONFIG.portPoolEnd;
            CONFIG.controlPort = data.controlPort || CONFIG.controlPort;
            CONFIG.httpPort = data.httpPort || CONFIG.httpPort;
            CONFIG.heartbeatIntervalMs = data.heartbeatIntervalMs || CONFIG.heartbeatIntervalMs;
            CONFIG.roomGracePeriodMs = data.roomGracePeriodMs || CONFIG.roomGracePeriodMs;
            CONFIG.maxPlayersPerRoom = data.maxPlayersPerRoom || CONFIG.maxPlayersPerRoom;
            engineStats.portPoolTotal = CONFIG.portPoolEnd - CONFIG.portPoolStart + 1;
            updateConfigDisplay();
        }
    }

    async function fetchRoomPlayers(roomId) {
        const data = await apiGet('/rooms/' + roomId + '/players');
        if (data && data.players) {
            const room = rooms.get(roomId);
            if (room) {
                room.players = data.players.map(p => ({
                    id: p.id,
                    connectedAt: p.connectedAt || '',
                    bytesSent: p.bytesSent || 0,
                    bytesRecv: p.bytesRecv || 0
                }));
                room.playerCount = room.players.length;
                room.tunnels = data.players.map(p => ({
                    id: 'T' + p.id,
                    playerId: p.id,
                    direction: '玩家 → 中继 ↔ 房主 → MC',
                    bytesForwarded: (p.bytesSent || 0) + (p.bytesRecv || 0),
                    createdAt: p.connectedAt || ''
                }));
            }
        }
    }

    // ======================== Room CRUD (via API) ========================
    async function createRoomFromModal() {
        const nameInput = document.getElementById('new-room-name');
        const mcPortInput = document.getElementById('new-room-mcport');
        const ipInput = document.getElementById('new-room-ip');
        const name = nameInput.value.trim() || ('房间_' + Date.now());
        const mcPortRaw = parseInt(mcPortInput.value) || 25565;

        // validate room name length
        if (name.length > 64) {
            showToast('❌ 房间名称不能超过 64 个字符（当前 ' + name.length + ' 个）');
            return;
        }

        // validate port range
        if (mcPortRaw < 1 || mcPortRaw > 65535) {
            showToast('❌ MC 端口必须在 1-65535 范围内（当前 ' + mcPortRaw + '）');
            return;
        }
        const mcPort = mcPortRaw;
        const roomIp = ipInput.value.trim() || CONFIG.relayIpv6 || CONFIG.relayIpv4 || CONFIG.publicIp;

        // validate the relay IP
        if (!isValidPublicIP(roomIp)) {
            showToast('❌ 中继服务器 IP 无效: ' + roomIp + '（需要公网地址）');
            return;
        }

        // 探测连通性用 127.0.0.1（relay 在本机），不通过外网
        const probeResult = await probeRelayIP('127.0.0.1', CONFIG.httpPort);
        if (probeResult !== true) {
            showToast('❌ 中继服务器未响应，请确认 relay 已启动');
            return;
        }

        // 创建房间请求始终发本地 relay
        const url = API_BASE + '/rooms';
        let result = null;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ roomName: name, localMcPort: mcPort })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                const msg = (data.error && data.error.message) || res.statusText;
                apiLog('POST', '/rooms', res.status, msg);
                throw new Error(msg);
            }
            apiLog('POST', '/rooms', res.status, data.connectionCode || '成功');
            result = data;
        } catch (e) {
            if (!e.message.includes('→')) {
                apiLog('POST', '/rooms', '失败', e.message);
            }
            showToast('请求失败: ' + e.message);
            return;
        }

        if (result) {
            const assignedPort = result.assignedPort || 0;
            const codeIp = roomIp.includes(':') ? '[' + roomIp + ']' : roomIp;
            const connectionCode = codeIp + ':' + assignedPort;
            const room = {
                roomId: result.roomId,
                roomName: result.roomName || name,
                relayIp: roomIp,
                connectionCode: connectionCode,
                assignedPort: assignedPort,
                localMcPort: result.localMcPort || mcPort,
                status: result.status || 'waiting',
                playerCount: result.playerCount || 0,
                createdAt: result.createdAt || new Date().toISOString(),
                players: [],
                tunnels: []
            };
            rooms.set(room.roomId, room);
            addLog('创建房间: ' + room.roomName + ' | 连接码: ' + room.connectionCode);
            showToast('房间已创建: ' + room.connectionCode);
        }

        nameInput.value = '';
        mcPortInput.value = '25565';
        ipInput.value = '';
        closeModal('create-room');
        await syncAll();
        renderAll();
    }

    async function closeRoomById(roomId) {
        const room = rooms.get(roomId);
        if (!room) return;
        await apiDelete('/rooms/' + roomId);
        room.status = 'closed';
        addLog('关闭房间: ' + room.roomName + ' | 端口 ' + room.assignedPort + ' 已回收');
        showToast('房间已关闭: ' + room.roomName);
        renderAll();
    }

    async function forceCloseRoomById(roomId) {
        const room = rooms.get(roomId);
        if (!room) return;
        await apiDelete('/rooms/' + roomId);
        room.status = 'closed';
        room.players = [];
        room.playerCount = 0;
        room.tunnels = [];
        addLog('强制关闭房间: ' + room.roomName);
        showToast('房间已强制关闭');
        renderAll();
    }

    function startRoomById(roomId) {
        const room = rooms.get(roomId);
        if (!room || room.status !== 'closed') return;
        room.status = 'waiting';
        addLog('启动房间: ' + room.roomName + ' | 连接码: ' + room.connectionCode);
        showToast('房间已启动: ' + room.roomName);
        renderAll();
    }

    function deleteRoomById(roomId) {
        const room = rooms.get(roomId);
        if (!room) return;
        const name = room.roomName;
        rooms.delete(roomId);
        addLog('删除房间: ' + name);
        showToast('房间已删除: ' + name);
        const detailView = document.getElementById('view-room-detail');
        if (detailView.classList.contains('active') && document.getElementById('detail-title').textContent === name) {
            showView('rooms');
        }
        renderAll();
    }

    // ======================== IP Validation ========================
    function isValidPublicIP(ip) {
        if (!ip) return false;
        // IPv6 check
        if (ip.includes(':')) {
            const lower = ip.toLowerCase();
            // reject loopback, link-local, multicast, unspecified
            if (lower === '::1') return false;
            if (lower.startsWith('fe80:')) return false;
            if (lower.startsWith('ff')) return false;
            if (lower === '::' || lower === '0:0:0:0:0:0:0:0') return false;
            // simplified: accept if it has colons and isn't obviously private
            return lower.includes(':');
        }
        // IPv4 check
        const parts = ip.split('.');
        if (parts.length !== 4) return false;
        const nums = parts.map(p => parseInt(p, 10));
        if (nums.some(n => isNaN(n) || n < 0 || n > 255)) return false;
        // reject private/link-local (but allow 127.0.0.1 for local dev)
        if (nums[0] === 10) return false;                      // class A private
        if (nums[0] === 172 && nums[1] >= 16 && nums[1] <= 31) return false; // class B private
        if (nums[0] === 192 && nums[1] === 168) return false;  // class C private
        if (nums[0] === 169 && nums[1] === 254) return false;  // link-local
        if (nums[0] === 0) return false;                       // "this network"
        if (nums[0] >= 224) return false;                      // multicast/reserved
        return true;
    }

    async function probeRelayIP(ip, port) {
        const url = 'http://' + (ip.includes(':') ? '[' + ip + ']' : ip) + ':' + (port || 8080) + '/api/v1/ping';
        try {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 5000);
            const res = await fetch(url, { signal: ctrl.signal });
            clearTimeout(timer);
            if (!res.ok) return 'HTTP ' + res.status;
            const data = await res.json();
            return (data && data.status === 'ok') ? true : ('响应异常: ' + JSON.stringify(data));
        } catch (e) {
            return e.message || '网络错误';
        }
    }

    async function saveRelayIP() {
        const setupPanel = document.getElementById('relay-ip-setup');
        const editPanel = document.getElementById('relay-ip-edit');
        const setupIpv6 = document.getElementById('setup-ipv6');
        const setupIpv4 = document.getElementById('setup-ipv4');
        const editIpv6 = document.getElementById('edit-ipv6');
        const editIpv4 = document.getElementById('edit-ipv4');

        let ipv6 = '', ipv4 = '';
        if (setupPanel && setupPanel.style.display !== 'none') {
            ipv6 = setupIpv6 ? setupIpv6.value.trim() : '';
            ipv4 = setupIpv4 ? setupIpv4.value.trim() : '';
        } else if (editPanel && editPanel.style.display !== 'none') {
            ipv6 = editIpv6 ? editIpv6.value.trim() : '';
            ipv4 = editIpv4 ? editIpv4.value.trim() : '';
        }

        if (!ipv6 && !CONFIG.relayConfigured) {
            showToast('❌ IPv6 地址为必填项');
            return;
        }

        // validate new IPs
        if (ipv6 && !isValidPublicIP(ipv6)) {
            showToast('❌ IPv6 不是有效的公网地址，请重新填写');
            return;
        }
        if (ipv4 && !isValidPublicIP(ipv4)) {
            showToast('❌ IPv4 不是有效的公网地址，请重新填写');
            return;
        }

        // probe: 用 127.0.0.1 检测本地 relay 是否正常（relay 在本机）
        const reachable = await probeRelayIP('127.0.0.1', CONFIG.httpPort);
        if (!reachable) {
            showToast('❌ 中继服务器未响应，请确认 relay 已启动');
        }

        CONFIG.relayIpv6 = ipv6 || CONFIG.relayIpv6;
        CONFIG.relayIpv4 = ipv4 || CONFIG.relayIpv4;
        CONFIG.relayConfigured = true;
        CONFIG.publicIp = CONFIG.relayIpv6 || CONFIG.relayIpv4;

        // ★ 同步到后端：POST /api/v1/config 通知 relay 更新公网 IP
        var newPublicIp = CONFIG.publicIp;
        if (newPublicIp) {
            fetch(API_BASE + '/config', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ publicIp: newPublicIp })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (d && d.status === 'ok') {
                    addLog('后端 IP 已同步: ' + newPublicIp);
                }
            }).catch(function(e) {
                addLog('后端 IP 同步失败: ' + e.message);
            });
        }

        // 判断是首次配置（启动服务器）还是编辑地址（不启动）
        const isSetup = setupPanel && setupPanel.style.display !== 'none';
        if (isSetup) {
            relayRunning = true;
            addLog('服务器已启动: IPv6=' + CONFIG.relayIpv6 + (CONFIG.relayIpv4 ? ' IPv4=' + CONFIG.relayIpv4 : ''));
            showToast('✅ 服务器已启动');
        } else {
            // 编辑地址，回到显示面板
            document.getElementById('relay-ip-edit').style.display = 'none';
            document.getElementById('relay-ip-panel').style.display = 'block';
            addLog('服务器地址已更新: IPv6=' + CONFIG.relayIpv6 + (CONFIG.relayIpv4 ? ' IPv4=' + CONFIG.relayIpv4 : ''));
            showToast('✅ 地址已保存');
        }
        await syncAll();
        renderAll();
    }

    function cancelEditIP() {
        document.getElementById('relay-ip-edit').style.display = 'none';
        document.getElementById('relay-ip-panel').style.display = 'block';
    }

    function showEditIP() {
        document.getElementById('relay-ip-panel').style.display = 'none';
        const editPanel = document.getElementById('relay-ip-edit');
        document.getElementById('edit-ipv6').value = CONFIG.relayIpv6 || '';
        document.getElementById('edit-ipv4').value = CONFIG.relayIpv4 || '';
        editPanel.style.display = 'block';
    }

    function shutdownRelay() {
        // freeze current uptime
        if (localStartTime > 0) {
            frozenUptime += Math.floor((Date.now() - localStartTime) / 1000);
        }
        localStartTime = 0;
        relayRunning = false;
        rooms.forEach(r => { r.status = 'closed'; r.players = []; r.playerCount = 0; r.tunnels = []; });
        addLog('中继服务器已停止');
        showToast('服务器已停止');
        renderAll();
    }

    function startRelay() {
        if (!CONFIG.relayConfigured) {
            showToast('请先配置服务器地址');
            return;
        }
        localStartTime = Date.now();
        relayRunning = true;
        addLog('中继服务器已启动');
        showToast('服务器已启动');
        syncAll().then(() => renderAll());
    }

    function addLog(msg) {
        eventLog.unshift({ time: new Date().toTimeString().slice(0, 8), msg: msg });
        if (eventLog.length > 50) eventLog.pop();
    }

    // ======================== Sync All ========================
    async function syncAll() {
        await Promise.all([fetchStats(), fetchRooms(), fetchConfig()]);
    }

    // ======================== Views ========================
    function showView(name) {
        document.querySelectorAll('.rail-item').forEach(b => {
            b.classList.toggle('active', b.dataset.view === name);
        });
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        const target = document.getElementById('view-' + name);
        if (target) target.classList.add('active');
        closeAllMenus();
        if (name === 'rooms') syncAll().then(() => renderAll());
        else if (name === 'relay') syncAll().then(() => renderAll());
        else renderAll();
    }

    function showRoomDetail(roomId) {
        const room = rooms.get(roomId);
        if (!room) return;
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        document.getElementById('view-room-detail').classList.add('active');
        fetchRoomPlayers(roomId).then(() => renderRoomDetail(room));
        closeAllMenus();
    }

    // ======================== Menu / Toast ========================
    function toggleMenu(e, id) {
        e.stopPropagation();
        const menu = document.getElementById(id);
        if (!menu) return;
        const isOpen = menu.classList.contains('show');
        closeAllMenus();
        if (!isOpen) menu.classList.add('show');
    }

    function closeAllMenus() {
        document.querySelectorAll('.context-menu').forEach(m => m.classList.remove('show'));
    }

    function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toast._timeout);
        toast._timeout = setTimeout(() => toast.classList.remove('show'), 2000);
    }

    function minimizeWindow() {
        try {
            if (window.chrome && window.chrome.webview && window.chrome.webview.postMessage) {
                window.chrome.webview.postMessage('minimize');
                return;
            }
        } catch (e) {}
        showToast('窗口已最小化');
    }

    function closeWindow() {
        try {
            if (window.chrome && window.chrome.webview && window.chrome.webview.postMessage) {
                window.chrome.webview.postMessage('close');
                return;
            }
        } catch (e) {}
        try { window.close(); } catch (e2) {}
    }

    async function copyText(text) {
        try {
            await navigator.clipboard.writeText(text);
            showToast('已复制: ' + text);
        } catch (e) {
            // fallback
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showToast('已复制: ' + text);
        }
    }

    // ======================== Render ========================
    function renderAll() {
        renderHomeStats();
        renderRelayKPI();
        renderRelayConnections();
        renderRelayTunnels();
        renderRoomGrid();
        renderLog();
    }

    function renderHomeStats() {
        // uptime 由 1s 定时器实时更新，此处不覆盖
        document.getElementById('s-active-rooms').textContent = engineStats.activeRooms;
        document.getElementById('s-active-tunnels').textContent = engineStats.activeTunnels;
        document.getElementById('s-bytes').textContent = formatBytes(engineStats.bytesRelayed);
        document.getElementById('s-ports').textContent = engineStats.portPoolUsed + ' / ' + engineStats.portPoolTotal;
        document.getElementById('s-connections').textContent = engineStats.totalConnections;
        document.getElementById('s-total-rooms').textContent = engineStats.totalRooms;
        document.getElementById('home-room-count').textContent = engineStats.activeRooms + ' 个活跃';
        const homeStatus = document.getElementById('home-relay-status');
        if (homeStatus) {
            if (!CONFIG.relayConfigured) homeStatus.textContent = '未配置';
            else if (!relayRunning) homeStatus.textContent = '已停止';
            else homeStatus.textContent = '运行中';
        }
    }

    function getAggregatedStats() {
        return {
            activeRooms: engineStats.activeRooms,
            activeTunnels: engineStats.activeTunnels
        };
    }

    function renderRelayKPI() {
        const stats = getAggregatedStats();
        // uptime 由 1s 定时器实时更新，此处不覆盖
        document.getElementById('kpi-rooms').textContent = stats.activeRooms;
        document.getElementById('kpi-tunnels').textContent = stats.activeTunnels;
        document.getElementById('kpi-bytes').innerHTML = formatBytes(engineStats.bytesRelayed).replace(' ', '<span>') + '</span>';

        // port pool
        const total = engineStats.portPoolTotal;
        const used = engineStats.portPoolUsed;
        const pct = total > 0 ? Math.min(100, Math.round((used / total) * 100)) : 0;
        document.getElementById('port-pool-text').textContent = used + ' / ' + total;
        const bar = document.getElementById('port-pool-bar');
        bar.style.width = pct + '%';
        bar.classList.remove('warn', 'danger');
        if (pct > 90) bar.classList.add('danger');
        else if (pct > 70) bar.classList.add('warn');
        document.getElementById('port-pool-range').textContent = CONFIG.portPoolStart + ' – ' + CONFIG.portPoolEnd;

        renderRelayIP();
    }

    function renderRelayIP() {
        const displayPanel = document.getElementById('relay-ip-panel');
        const setupPanel = document.getElementById('relay-ip-setup');
        const editPanel = document.getElementById('relay-ip-edit');
        const startBtn = document.getElementById('btn-start-relay');
        const shutdownBtn = document.getElementById('btn-shutdown-relay');
        const statusText = document.getElementById('status-text');
        const statusDot = document.querySelector('.status-chip .dot');
        const editBtn = document.getElementById('btn-edit-ip');

        if (!CONFIG.relayConfigured) {
            // not configured yet — show setup form
            if (displayPanel) displayPanel.style.display = 'none';
            if (editPanel) editPanel.style.display = 'none';
            if (setupPanel) setupPanel.style.display = 'block';
            if (startBtn) startBtn.style.display = '';
            if (shutdownBtn) shutdownBtn.style.display = 'none';
            if (editBtn) editBtn.style.display = 'none';
            if (statusText) statusText.textContent = '未配置 — 请先设置服务器地址';
            if (statusDot) { statusDot.classList.add('warn'); statusDot.classList.remove('off'); }
            return;
        }

        if (!relayRunning) {
            // configured but stopped — show display + edit button
            if (setupPanel) setupPanel.style.display = 'none';
            if (editPanel) editPanel.style.display = 'none';
            if (displayPanel) displayPanel.style.display = 'block';
            if (startBtn) startBtn.style.display = '';
            if (shutdownBtn) shutdownBtn.style.display = 'none';
            if (editBtn) editBtn.style.display = '';
            document.getElementById('relay-ipv6-display').textContent = CONFIG.relayIpv6 || '未配置';
            document.getElementById('relay-ipv4-display').textContent = CONFIG.relayIpv4 || '未配置';
            if (statusText) statusText.textContent = '服务器已停止';
            if (statusDot) { statusDot.classList.remove('warn'); statusDot.classList.add('off'); }
            return;
        }

        // configured and running — show stop button, hide edit button
        if (setupPanel) setupPanel.style.display = 'none';
        if (editPanel) editPanel.style.display = 'none';
        if (displayPanel) displayPanel.style.display = 'block';
        if (startBtn) startBtn.style.display = 'none';
        if (shutdownBtn) shutdownBtn.style.display = '';
        if (editBtn) editBtn.style.display = 'none';
        document.getElementById('relay-ipv6-display').textContent = CONFIG.relayIpv6 || '未配置';
        document.getElementById('relay-ipv4-display').textContent = CONFIG.relayIpv4 || '未配置';
        if (statusText) statusText.textContent = '中继服务运行中';
        if (statusDot) { statusDot.classList.remove('warn', 'off'); }
    }

