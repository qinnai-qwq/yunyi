    // ======================== Real-time Uptime (1s) ========================
    let localStartTime = 0;    // Date.now() when relay was started (client clock)
    let frozenUptime = 0;      // frozen uptime seconds when relay is stopped
    setInterval(() => {
        let uptime = frozenUptime;
        if (relayRunning && localStartTime > 0) {
            uptime = Math.max(0, frozenUptime + Math.floor((Date.now() - localStartTime) / 1000));
        }
        const text = formatUptime(uptime);
        const sUptime = document.getElementById('s-uptime');
        const kpiUptime = document.getElementById('kpi-uptime');
        if (sUptime) sUptime.textContent = text;
        if (kpiUptime) kpiUptime.textContent = text;
    }, 1000);

    // ======================== Backend Log Polling (2s) ========================
    var backendLogSeen = 0;
    setInterval(async () => {
        try {
            var r = await fetch(API_BASE + '/logs');
            var d = await r.json();
            if (d && d.logs) {
                var added = false;
                for (var i = backendLogSeen; i < d.logs.length; i++) {
                    var entry = d.logs[i];
                    // 去重: 不在已有 eventLog 中重复
                    eventLog.unshift({ time: entry.time, msg: '[后端] ' + entry.msg });
                    added = true;
                }
                backendLogSeen = d.logs.length;
                if (added) {
                    eventLog = eventLog.slice(0, 50);
                    var container = document.getElementById('log-container');
                    if (container) {
                        container.innerHTML = eventLog.slice(0, 15).map(function(e) {
                            return '<div class="log-line"><span class="log-time">' + e.time + '</span> ' + escHtml(e.msg) + '</div>';
                        }).join('');
                    }
                }
            }
        } catch(e) {}
    }, 2000);

    // ======================== Backend Polling (5s) ========================
    setInterval(async () => {
        if (!relayRunning) return;
        await syncAll();

        // re-render room detail if visible
        const detailView = document.getElementById('view-room-detail');
        if (detailView.classList.contains('active')) {
            const detailId = document.getElementById('rinfo-id');
            if (detailId) {
                const roomId = parseInt(detailId.textContent);
                if (roomId) {
                    await fetchRoomPlayers(roomId);
                    const room = rooms.get(roomId);
                    if (room) renderRoomDetail(room);
                }
            }
        }
        renderAll();
    }, 5000);

    // ======================== Initial ========================
    (async () => {
        const ping = await apiGet('/ping');
        if (ping && ping.status === 'ok') {
            addLog('后端服务已就绪');
        }
        await syncAll();
        // 从 /config 恢复已配置的 IP（如果有）
        if (CONFIG.publicIp) {
            CONFIG.relayConfigured = true;
        }
        // relayRunning 保持 false — 用户需手动点击启动
        relayRunning = false;
        frozenUptime = 0;
        renderAll();
    })();
</script>

</body>
</html>
