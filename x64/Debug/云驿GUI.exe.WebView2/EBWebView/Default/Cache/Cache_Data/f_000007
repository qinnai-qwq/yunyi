        document.getElementById('detail-sub').textContent = '连接码: ' + room.connectionCode;
        document.getElementById('detail-addr').textContent = '分配端口 ' + room.assignedPort + ' · MC端口 ' + room.localMcPort + ' · 创建于 ' + room.createdAt;

