                <div class="tunnel-item">
                    <span style="font-family:var(--font-mono);font-size:11.5px;">${t.id}</span>
                    <span style="font-size:12px;color:var(--text-secondary);">玩家 ${t.playerId}</span>
                    <span class="tunnel-dir">${t.direction}</span>
                    <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-tertiary);">${formatBytes(t.bytesForwarded)}</span>
