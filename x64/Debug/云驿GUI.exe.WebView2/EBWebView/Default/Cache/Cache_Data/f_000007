<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>云驿 — Minecraft 联机中继</title>
    <style>
        :root {
            --bg: #F3F5F8;
            --surface: #FFFFFF;
            --surface-alt: #FAFBFD;
            --border: #E2E6EC;
            --border-strong: #CFD5DE;
            --text: #151A22;
            --text-secondary: #5B6472;
            --text-tertiary: #98A1AC;
            --rail: #181D27;
            --rail-icon: #7C8598;
            --rail-icon-active: #FFFFFF;
            --primary: #2C5FB3;
            --primary-dark: #1E3F7A;
            --primary-soft: #EAF0FB;
            --relay: #2C5FB3;
            --relay-soft: #EAF0FB;
            --host: #0E9488;
            --host-soft: #E4F5F3;
            --room: #7C3AED;
            --room-soft: #F0EBFC;
            --success: #17A34A;
            --success-soft: #E9F8EE;
            --danger: #DC4545;
            --danger-soft: #FCEAEA;
            --warn: #B4720A;
            --warn-soft: #FBF1DF;
            --radius-lg: 14px;
            --radius-md: 10px;
            --radius-sm: 7px;
            --font-ui: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
            --font-mono: "Cascadia Code", "Consolas", "Segoe UI Mono", monospace;
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            margin: 0;
            font-family: var(--font-ui);
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            -webkit-user-select: none;
            /* padding: 20px; */
        }
        ::selection { background: var(--primary-soft); color: var(--primary-dark); }

        .app {
            width: 100%;
            height: 100%;
            /* max-width: 1500px;
            max-height: 960px; 
            min-width: 1100px;
            min-height: 700px;*/
            background: var(--surface);
            /* border-radius: 16px; */
            overflow: hidden;
            box-shadow: 0 30px 60px -20px rgba(20,30,50,.25), 0 0 0 1px rgba(20,30,50,.04);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* ===== Titlebar ===== */
        .titlebar {
            height: 52px; flex: 0 0 auto;
            display: flex; align-items: center;
            padding: 0 10px 0 18px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
        }
        .brand {
            display: flex; align-items: center; gap: 9px;
            font-weight: 700; font-size: 15.5px; letter-spacing: .2px;
        }
        .brand-mark {
            width: 22px; height: 22px; border-radius: 6px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
        }
        .brand-mark svg { width: 13px; height: 13px; }
        .brand small {
            font-weight: 500; font-size: 11px;
            color: var(--text-tertiary); margin-left: 2px;
        }
        .titlebar-spacer { flex: 1; }
        .status-chip {
            display: flex; align-items: center; gap: 6px;
            font-size: 12.5px; color: var(--text-secondary);
            padding: 5px 10px; border-radius: 999px;
            background: var(--surface-alt); border: 1px solid var(--border);
            margin-right: 10px;
        }
        .dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--success); flex: 0 0 auto;
        }
        .dot.warn { background: var(--warn); }
        .dot.off { background: var(--text-tertiary); }
        .titlebar-btn {
            width: 30px; height: 30px; border-radius: 8px;
            border: none; background: transparent; color: var(--text-secondary);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; flex: 0 0 auto;
        }
        .titlebar-btn:hover { background: var(--surface-alt); }
        .titlebar-btn.close:hover { background: var(--danger); color: #fff; }
        .titlebar-btn svg { width: 13px; height: 13px; }

        /* ===== Body / Rail ===== */
        .body { flex: 1; display: flex; min-height: 0; }
        .rail {
            width: 76px; flex: 0 0 auto; background: var(--rail);
            display: flex; flex-direction: column; align-items: center;
            padding: 16px 0;
        }
        .rail-group {
            display: flex; flex-direction: column; gap: 4px;
            width: 100%; align-items: center;
        }
        .rail-spacer { flex: 1; }
        .rail-item {
            width: 56px; height: 56px; border-radius: 12px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 5px;
            color: var(--rail-icon); cursor: pointer;
            background: transparent; border: none;
            font-size: 11px; font-family: var(--font-ui); position: relative;
        }
        .rail-item svg { width: 19px; height: 19px; }
        .rail-item:hover { color: #C4CCDA; }
        .rail-item.active { color: var(--rail-icon-active); background: rgba(255,255,255,.06); }
        .rail-item.active::before {
            content: ""; position: absolute; left: -16px; top: 50%;
            transform: translateY(-50%); width: 3px; height: 22px;
            border-radius: 3px; background: var(--primary);
        }
        .rail-divider {
            width: 32px; height: 1px;
            background: rgba(255,255,255,.08); margin: 10px 0;
        }
        .rail-version {
            color: var(--text-tertiary); font-size: 10.5px; margin-top: 4px;
        }

        /* ===== Content / Views ===== */
        .content { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .view { display: none; flex: 1; min-height: 0; flex-direction: column; }
        .view.active { display: flex; }

        .view-head {
            padding: 22px 28px 16px;
            display: flex; align-items: center; gap: 14px; flex: 0 0 auto;
        }
        .back-btn {
            width: 32px; height: 32px; border-radius: 9px;
            border: 1px solid var(--border); background: var(--surface);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-secondary); flex: 0 0 auto;
        }
        .back-btn:hover { background: var(--surface-alt); }
        .back-btn svg { width: 14px; height: 14px; }
        .view-title { font-size: 19px; font-weight: 700; letter-spacing: .1px; }
        .view-sub { font-size: 12.5px; color: var(--text-tertiary); margin-top: 2px; font-weight: 500; }
        .view-head-spacer { flex: 1; }

        .scroll { flex: 1; overflow-y: auto; padding: 0 28px 28px; }

        /* ===== Buttons ===== */
        .btn {
            display: inline-flex; align-items: center; gap: 7px;
            border: none; border-radius: 9px; padding: 9px 15px;
            font-family: var(--font-ui); font-size: 13px;
            font-weight: 600; cursor: pointer; transition: .15s;
        }
        .btn svg { width: 14px; height: 14px; }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-ghost {
            background: var(--surface-alt); color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .btn-ghost:hover { border-color: var(--border-strong); color: var(--text); }
        .btn-danger { background: var(--danger-soft); color: var(--danger); border: 1px solid transparent; }
        .btn-danger:hover { background: var(--danger); color: #fff; }
        .btn-sm { padding: 6px 11px; font-size: 12px; border-radius: 7px; }
        .btn-sm svg { width: 12px; height: 12px; }

        /* ===== Stats Modules ===== */
        .stats-modules {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 14px; margin-bottom: 22px;
        }
        .stat-module {
            background: var(--surface-alt); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: 16px 18px;
        }
        .stat-module .module-title {
            font-size: 15px; font-weight: 700; margin-bottom: 12px;
            padding-bottom: 8px; border-bottom: 2px solid var(--border);
            display: flex; align-items: center; gap: 8px;
        }
        .stat-module .module-title .badge {
            display: inline-block; width: 8px; height: 8px; border-radius: 50%;
        }
        .stat-module.relay .module-title .badge { background: var(--relay); }
        .stat-module.ports .module-title .badge { background: var(--room); }
        .stat-module .stat-item {
            display: flex; justify-content: space-between;
            padding: 6px 0; font-size: 13px;
            border-bottom: 1px dashed var(--border);
        }
        .stat-module .stat-item:last-child { border-bottom: none; }
        .stat-module .stat-item .label { color: var(--text-secondary); font-weight: 500; }
        .stat-module .stat-item .value { font-family: var(--font-mono); font-weight: 600; }

        /* ===== Relay IP + Port Pool duo ===== */
        .relay-duo {
            display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;
        }
        .relay-ip-panel {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: 16px 18px;
        }
        .relay-ip-panel .ip-title {
            font-size: 13.5px; font-weight: 700; margin-bottom: 12px;
            padding-bottom: 8px; border-bottom: 2px solid var(--border);
            display: flex; align-items: center; gap: 8px;
        }
        .relay-ip-panel .ip-title .badge { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--relay); }
        .relay-ip-row {
            display: flex; align-items: center; padding: 8px 0;
            border-bottom: 1px dashed var(--border); gap: 10px;
        }
        .relay-ip-row:last-child { border-bottom: none; }
        .relay-ip-row .ip-label {
            font-family: var(--font-mono); font-size: 11px; font-weight: 700;
            color: var(--text-tertiary); width: 42px; flex: 0 0 auto;
        }
        .relay-ip-row .ip-value {
            font-family: var(--font-mono); font-size: 13px; font-weight: 600; flex: 1;
        }
        .relay-ip-row .ip-edit {
            font-family: var(--font-mono); font-size: 12px;
            padding: 5px 8px; border-radius: 6px; width: 100%;
            border: 1px solid var(--border); background: var(--surface);
            color: var(--text);
        }
        .relay-ip-row .ip-edit:focus { outline: none; border-color: var(--primary); }
        .relay-ip-row .ip-edit::placeholder { color: var(--text-tertiary); font-family: var(--font-ui); font-size: 11px; }
        .relay-setup-hint {
            font-size: 11px; color: var(--warn); margin-top: 8px; font-weight: 500;
        }
        .relay-ip-actions { margin-top: 10px; display: flex; gap: 8px; }

        /* ===== Panel ===== */
        .panel {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); margin-bottom: 16px;
        }
        .panel-head {
            display: flex; align-items: center;
            padding: 14px 18px; border-bottom: 1px solid var(--border);
        }
        .panel-head h3 { margin: 0; font-size: 13.5px; font-weight: 700; }
        .panel-head .view-sub { margin: 0 0 0 8px; }
        .panel-body { padding: 14px 18px; }

        /* ===== Role Cards (home quick actions) ===== */
        .role-split {
            display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
        }
        .role-card {
            border: 1px solid var(--border); border-radius: var(--radius-md);
            padding: 16px; display: flex; flex-direction: column; gap: 10px;
            cursor: pointer; border-left: 3px solid var(--border); transition: .12s;
        }
        .role-card.relay { border-left-color: var(--relay); }
        .role-card.rooms { border-left-color: var(--room); }
        .role-card:hover { background: var(--surface-alt); }
        .role-card-top {
            display: flex; align-items: center; justify-content: space-between;
        }
        .role-card-title {
            display: flex; align-items: center; gap: 8px;
            font-weight: 700; font-size: 13.5px;
        }
        .role-badge {
            width: 28px; height: 28px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
        }
        .role-badge svg { width: 15px; height: 15px; }
        .role-badge.relay { background: var(--relay-soft); color: var(--relay); }
        .role-badge.rooms { background: var(--room-soft); color: var(--room); }
        .role-badge.host { background: var(--host-soft); color: var(--host); }
        .role-count { font-family: var(--font-mono); font-size: 12px; color: var(--text-tertiary); }
        .role-card-desc { font-size: 12.5px; color: var(--text-secondary); line-height: 1.6; }

        /* ===== KPI Grid ===== */
        .kpi-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 14px; margin-bottom: 22px;
        }
        .kpi-card {
            background: var(--surface-alt); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: 16px 18px;
        }
        .kpi-top {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 10px;
        }
        .kpi-label { font-size: 12px; color: var(--text-tertiary); font-weight: 600; }
        .kpi-icon {
            width: 26px; height: 26px; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
        }
        .kpi-icon svg { width: 14px; height: 14px; }
        .kpi-value { font-family: var(--font-mono); font-size: 22px; font-weight: 600; letter-spacing: -.3px; }
        .kpi-value span { font-size: 12px; color: var(--text-tertiary); font-family: var(--font-ui); font-weight: 500; margin-left: 4px; }

        /* ===== Room Cards ===== */
        .list-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
        }
        .create-card {
            border: 1.5px dashed var(--border-strong); border-radius: var(--radius-lg);
            display: flex; align-items: center; justify-content: center;
            flex-direction: column; gap: 8px; min-height: 230px;
            cursor: pointer; color: var(--text-tertiary); transition: .15s;
        }
        .create-card:hover { border-color: var(--room); color: var(--room); background: var(--room-soft); }
        .create-card svg { width: 22px; height: 22px; }
        .create-card span { font-size: 13px; font-weight: 600; }

        .room-card {
            border: 1px solid var(--border); border-radius: var(--radius-lg);
            padding: 16px 16px 14px; position: relative; cursor: pointer;
            border-left: 3px solid var(--room); transition: .12s;
        }
        .room-card:hover { background: var(--surface-alt); }
        .room-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
        .room-name { font-weight: 700; font-size: 14px; }
        .room-code {
            font-family: var(--font-mono); font-size: 13px; color: var(--primary);
            background: var(--primary-soft); padding: 3px 8px; border-radius: 5px;
            margin-top: 6px; display: inline-flex; align-items: center; gap: 6px;
            cursor: pointer; user-select: all;
        }
        .room-code .copy-hint {
            font-size: 10px; color: var(--text-tertiary); font-family: var(--font-ui);
            user-select: none;
        }
        .room-meta {
            font-family: var(--font-mono); font-size: 11.5px;
            color: var(--text-tertiary); margin-top: 6px;
        }

        .more-wrap { position: relative; flex: 0 0 auto; }
        .item-more {
            width: 26px; height: 26px; border-radius: 7px;
            border: none; background: transparent; color: var(--text-tertiary);
            cursor: pointer; display: flex; align-items: center; justify-content: center;
        }
        .item-more:hover { background: var(--surface-alt); color: var(--text); }
        .item-more svg { width: 15px; height: 15px; }

        .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
        .pill {
            font-size: 11px; font-weight: 600; padding: 4px 9px;
            border-radius: 999px; background: var(--surface-alt);
            color: var(--text-secondary); border: 1px solid var(--border);
        }
        .pill.on { background: var(--success-soft); color: var(--success); border-color: transparent; }
        .pill.waiting { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
        .pill.closed { background: var(--surface-alt); color: var(--text-tertiary); }
        .pill.accent { background: var(--room-soft); color: var(--room); border-color: transparent; }
        .pill.relay-pill { background: var(--relay-soft); color: var(--relay); border-color: transparent; }
        .pill.host-pill { background: var(--host-soft); color: var(--host); border-color: transparent; }

        .room-stats {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 8px; margin-top: 14px; padding-top: 12px;
            border-top: 1px solid var(--border);
        }
        .stat-mini { text-align: center; }
        .stat-mini .v { font-family: var(--font-mono); font-size: 13px; font-weight: 700; }
        .stat-mini .l { font-size: 10.5px; color: var(--text-tertiary); margin-top: 2px; }

        /* ===== Context Menu ===== */
        .context-menu {
            position: absolute; top: 34px; right: 0; z-index: 20;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 10px; box-shadow: 0 12px 28px -8px rgba(20,30,50,.25);
            width: 160px; padding: 6px; display: none;
        }
        .context-menu.show { display: block; }
        .context-menu button {
            width: 100%; text-align: left; background: none; border: none;
            padding: 8px 10px; border-radius: 7px;
            font-family: var(--font-ui); font-size: 12.5px;
            color: var(--text); cursor: pointer;
        }
        .context-menu button:hover { background: var(--surface-alt); }
        .context-menu button.danger { color: var(--danger); }
        .context-menu hr { border: none; border-top: 1px solid var(--border); margin: 5px 2px; }

        /* ===== Room Detail ===== */
        .detail-hero {
            background: var(--surface-alt); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: 18px 20px; margin-bottom: 18px;
        }
        .detail-hero-top {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 10px;
        }
        .detail-addr {
            font-family: var(--font-mono); font-size: 12.5px;
            color: var(--text-secondary); margin-top: 6px;
        }

        .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
        .tab {
            padding: 10px 4px; margin-right: 20px;
            font-size: 13px; font-weight: 600; color: var(--text-tertiary);
            border-bottom: 2px solid transparent; cursor: pointer;
        }
        .tab.active { color: var(--primary); border-bottom-color: var(--primary); }

        /* ===== Player Table ===== */
        .kv-table { width: 100%; border-collapse: collapse; }
        .kv-table td {
            padding: 9px 4px; font-size: 12.5px;
            border-bottom: 1px dashed var(--border);
        }
        .kv-table td:first-child { color: var(--text-tertiary); width: 130px; }
        .kv-table td:last-child { font-family: var(--font-mono); }
        .kv-table th {
            text-align: left; padding: 8px 4px; font-size: 12px;
            color: var(--text-tertiary); font-weight: 600;
            border-bottom: 1px solid var(--border);
        }
        .player-row { transition: .1s; }
        .player-row:hover { background: var(--surface-alt); }

        /* ===== Progress Bar ===== */
        .progress-wrap { margin: 10px 0; }
        .progress-label { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
        .progress-label span:first-child { color: var(--text-secondary); font-weight: 500; }
        .progress-label span:last-child { font-family: var(--font-mono); color: var(--text-tertiary); }
        .progress-bar {
            height: 8px; border-radius: 999px; background: var(--border);
            overflow: hidden;
        }
        .progress-fill {
            height: 100%; border-radius: 999px; background: var(--primary);
            transition: width .3s;
        }
        .progress-fill.warn { background: var(--warn); }
        .progress-fill.danger { background: var(--danger); }

        /* ===== Log ===== */
        .log-line {
            font-family: var(--font-mono); font-size: 12px;
            color: var(--text-secondary); padding: 7px 0;
            border-bottom: 1px dashed var(--border); display: flex; gap: 10px;
        }
        .log-line:last-child { border-bottom: none; }
        .log-time { color: var(--text-tertiary); flex: 0 0 auto; }

        /* ===== Connection List ===== */
        .conn-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 0; border-bottom: 1px dashed var(--border);
        }
        .conn-item:last-child { border-bottom: none; }
        .conn-info { display: flex; align-items: center; gap: 10px; }
        .conn-info .name { font-weight: 600; font-size: 13px; }
        .conn-info .addr { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-tertiary); }

        /* ===== Empty ===== */
        .empty {
            display: flex; flex-direction: column; align-items: center;
            justify-content: center; padding: 70px 20px;
            color: var(--text-tertiary); gap: 10px;
        }
        .empty svg { width: 34px; height: 34px; opacity: .5; }
        .empty span { font-size: 13px; }

        /* ===== Settings ===== */
        .settings-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 4px; border-bottom: 1px solid var(--border);
        }
        .settings-row:last-child { border-bottom: none; }
        .settings-label { font-size: 13px; font-weight: 600; }
        .settings-desc { font-size: 12px; color: var(--text-tertiary); margin-top: 3px; font-weight: 500; }
        .switch {
            width: 38px; height: 22px; border-radius: 999px;
            background: var(--border-strong); position: relative;
            cursor: pointer; flex: 0 0 auto;
        }
        .switch.on { background: var(--primary); }
        .switch::after {
            content: ""; position: absolute; top: 2px; left: 2px;
            width: 18px; height: 18px; border-radius: 50%;
            background: #fff; transition: .15s;
            box-shadow: 0 1px 2px rgba(0,0,0,.2);
        }
        .switch.on::after { left: 18px; }

        .config-table { width: 100%; border-collapse: collapse; }
        .config-table td {
            padding: 10px 8px; font-size: 12.5px;
            border-bottom: 1px dashed var(--border);
        }
        .config-table td:first-child { color: var(--text-tertiary); width: 180px; font-weight: 500; }
        .config-table td:last-child { font-family: var(--font-mono); font-weight: 600; }

        /* ===== Modal ===== */
        .modal-overlay {
            position: absolute; inset: 0;
            background: rgba(13,18,28,.5); display: none;
            align-items: center; justify-content: center; z-index: 100;
        }
        .modal-overlay.show { display: flex; }
        .modal {
            width: 440px; max-height: 80%; overflow-y: auto;
            background: var(--surface); border-radius: 16px;
            box-shadow: 0 24px 60px -12px rgba(10,15,25,.4);
        }
        .modal-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 20px; border-bottom: 1px solid var(--border);
        }
        .modal-head h2 { margin: 0; font-size: 15.5px; font-weight: 700; }
        .modal-close {
            width: 28px; height: 28px; border-radius: 8px;
            border: none; background: var(--surface-alt);
            color: var(--text-secondary); cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .modal-close svg { width: 13px; height: 13px; }
        .modal-close:hover { background: var(--border); }
        .modal-body { padding: 18px 20px; }
        .modal-footer {
            padding: 14px 20px; border-top: 1px solid var(--border);
            display: flex; justify-content: flex-end; gap: 8px;
        }
        .form-group { margin-bottom: 16px; }
        .form-group label {
            display: block; font-size: 12.5px; font-weight: 600;
            color: var(--text-secondary); margin-bottom: 6px;
        }
        .form-hint { font-size: 11.5px; color: var(--text-tertiary); margin-top: 5px; font-weight: 500; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-input, .form-select {
            width: 100%; font-family: var(--font-mono); font-size: 12.5px;
            padding: 9px 11px; border-radius: 8px;
            border: 1px solid var(--border); background: var(--surface-alt);
            color: var(--text);
        }
        .form-input::placeholder { color: var(--text-tertiary); font-family: var(--font-ui); }
        .form-input:focus, .form-select:focus {
            outline: none; border-color: var(--primary); background: var(--surface);
        }
        .form-select { font-family: var(--font-ui); }
        .form-switch-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 0; border-bottom: 1px solid var(--border);
        }
        .form-switch-row:last-child { border-bottom: none; }
        .form-switch-label { font-size: 12.5px; font-weight: 600; }

        /* ===== Toast ===== */
        .toast {
            position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
            background: var(--rail); color: #fff; padding: 10px 20px;
            border-radius: 999px; font-size: 13px; font-weight: 600;
            z-index: 200; opacity: 0; transition: opacity .2s;
            pointer-events: none;
        }
        .toast.show { opacity: 1; }

        /* ===== Empty state for lists ===== */
        .tunnel-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 0; border-bottom: 1px dashed var(--border);
            font-size: 12.5px;
        }
        .tunnel-item:last-child { border-bottom: none; }
        .tunnel-dir { font-family: var(--font-mono); font-size: 11px; color: var(--text-tertiary); }
    </style>
</head>
<body>

<div class="app">

    <!-- ===== Titlebar ===== -->
    <div class="titlebar">
        <div class="brand">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 16l4-10 3 7 4-11 3 14" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            云驿 <small>v0.4.0</small>
        </div>
        <div class="titlebar-spacer"></div>
        <div class="status-chip"><span class="dot off"></span><span id="status-text">加载中...</span></div>
        <button class="titlebar-btn" onclick="minimizeWindow()" title="最小化">
            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="2" fill="currentColor"/></svg>
        </button>
        <button class="titlebar-btn close" onclick="closeWindow()" title="关闭">
            <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
    </div>

    <!-- ===== Body ===== -->
    <div class="body">

        <!-- Rail Navigation -->
        <div class="rail">
            <div class="rail-group">
                <button class="rail-item active" data-view="home">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M4 11.5L12 4l8 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9h12v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    主页
                </button>
                <button class="rail-item" data-view="relay">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="13.5" width="16" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.8"/><circle cx="7.3" cy="7.25" r="1" fill="currentColor"/><circle cx="7.3" cy="16.75" r="1" fill="currentColor"/></svg>
                    中继
                </button>
                <button class="rail-item" data-view="rooms">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/></svg>
                    房间
                </button>
            </div>
            <div class="rail-spacer"></div>
            <div class="rail-group">
                <button class="rail-item" data-view="settings">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M12 3v2.4M12 18.6V21M4.9 6.5l1.7 1.7M17.4 15.8l1.7 1.7M3 12h2.4M18.6 12H21M4.9 17.5l1.7-1.7M17.4 8.2l1.7-1.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    设置
                </button>
            </div>
            <div class="rail-version">v0.4.0</div>
        </div>

        <!-- Content Area -->
        <div class="content">

            <!-- ===== 主页 ===== -->
            <div class="view active" id="view-home">
                <div class="view-head">
                    <div>
                        <div class="view-title">主页</div>
                        <div class="view-sub">云驿 Minecraft 联机中继服务器</div>
                    </div>
                    <div class="view-head-spacer"></div>
                    <button class="btn btn-primary" onclick="openCreateRoomModal()">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                        创建房间
                    </button>
                </div>
                <div class="scroll">
                    <!-- Stats -->
                    <div class="stats-modules">
                        <div class="stat-module relay">
                            <div class="module-title"><span class="badge"></span> 中继服务器</div>
                            <div class="stat-item"><span class="label">运行时长</span><span class="value" id="s-uptime">00:00:00</span></div>
                            <div class="stat-item"><span class="label">活跃房间</span><span class="value" id="s-active-rooms">0</span></div>
                            <div class="stat-item"><span class="label">活跃隧道</span><span class="value" id="s-active-tunnels">0</span></div>
                            <div class="stat-item"><span class="label">累计转发流量</span><span class="value" id="s-bytes">0 B</span></div>
                        </div>
                        <div class="stat-module ports">
                            <div class="module-title"><span class="badge"></span> 端口池</div>
                            <div class="stat-item"><span class="label">已用 / 总量</span><span class="value" id="s-ports">0 / 1001</span></div>
                            <div class="stat-item"><span class="label">活跃连接数</span><span class="value" id="s-connections">0</span></div>
                            <div class="stat-item"><span class="label">累计房间</span><span class="value" id="s-total-rooms">0</span></div>
                            <div class="stat-item"><span class="label">协议版本</span><span class="value">v1</span></div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="panel">
                        <div class="panel-head"><h3>快捷操作</h3><span class="view-sub">选择功能进入对应管理页</span></div>
                        <div class="panel-body">
                            <div class="role-split">
                                <div class="role-card relay" onclick="showView('relay')">
                                    <div class="role-card-top">
                                        <div class="role-card-title">
                                            <span class="role-badge relay">
                                                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="13.5" width="16" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.8"/></svg>
                                            </span>
                                            中继服务器
                                        </div>
                                        <span class="role-count" id="home-relay-status">未启动</span>
                                    </div>
                                    <div class="role-card-desc">查看端口池使用情况、控制连接和数据隧道状态。中继服务器是云驿的核心，负责端口分配与字节转发。</div>
                                </div>
                                <div class="role-card rooms" onclick="showView('rooms')">
                                    <div class="role-card-top">
                                        <div class="role-card-title">
                                            <span class="role-badge rooms">
                                                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/></svg>
                                            </span>
                                            房间管理
                                        </div>
                                        <span class="role-count" id="home-room-count">0 个活跃</span>
                                    </div>
                                    <div class="role-card-desc">管理所有联机房间，查看连接码、玩家列表。房主创建房间后，朋友用连接码即可在 MC 中直接进入。</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Event Log -->
                    <div class="panel">
                        <div class="panel-head"><h3>事件日志</h3><span class="view-sub">最近操作记录</span></div>
                        <div class="panel-body" id="log-container">
                            <div class="empty" style="padding:30px 20px;">
                                <span style="font-size:12.5px;">暂无事件，请创建房间或等待玩家连接</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== 中继服务器 ===== -->
            <div class="view" id="view-relay">
                <div class="view-head">
                    <div>
                        <div class="view-title">中继服务器</div>
                        <div class="view-sub">端口池 · 控制连接 · 数据隧道</div>
                    </div>
                    <div class="view-head-spacer"></div>
                    <button class="btn btn-ghost" onclick="refreshStats()">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 4v5h5M20 20v-5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 10A8 8 0 004.7 16.1M4 14a8 8 0 0015.3 3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                        刷新
                    </button>
                    <button class="btn btn-primary" onclick="startRelay()" id="btn-start-relay">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M6 4l14 8-14 8V4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        启动服务器
                    </button>
                    <button class="btn btn-danger" onclick="shutdownRelay()" id="btn-shutdown-relay" style="display:none;">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v9M16 6.5a7.5 7.5 0 11-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        停止服务器
                    </button>
                </div>
                <div class="scroll">
                    <!-- KPI -->
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">运行时长</span>
                                <span class="kpi-icon" style="background:var(--warn-soft);color:var(--warn);">
                                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                                </span>
                            </div>
                            <div class="kpi-value" id="kpi-uptime">00:00:00</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">活跃房间</span>
                                <span class="kpi-icon" style="background:var(--room-soft);color:var(--room);">
                                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.8"/></svg>
                                </span>
                            </div>
                            <div class="kpi-value" id="kpi-rooms">0</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">活跃隧道</span>
                                <span class="kpi-icon" style="background:var(--host-soft);color:var(--host);">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M4 17l5-6 4 4 7-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                            </div>
                            <div class="kpi-value" id="kpi-tunnels">0</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">转发流量</span>
                                <span class="kpi-icon" style="background:var(--success-soft);color:var(--success);">
                                    <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M9 12h6M12 9v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                                </span>
                            </div>
                            <div class="kpi-value" id="kpi-bytes">0<span>B</span></div>
                        </div>
                    </div>

                    <!-- Server IP + Port Pool duo -->
                    <div class="relay-duo">
                        <!-- Server IP Panel -->
                        <div class="relay-ip-panel" id="relay-ip-panel">
                            <div class="ip-title" style="justify-content:space-between;">
                                <span style="display:flex;align-items:center;gap:8px;"><span class="badge"></span> 服务器地址</span>
                                <button class="btn btn-ghost btn-sm" id="btn-edit-ip" onclick="showEditIP()" style="display:none;">修改地址</button>
                            </div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv6</span>
                                <span class="ip-value" id="relay-ipv6-display">未配置</span>
                            </div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv4</span>
                                <span class="ip-value" id="relay-ipv4-display">未配置</span>
                            </div>
                        </div>
                        <!-- Setup form (hidden when configured) -->
                        <div class="relay-ip-panel" id="relay-ip-setup" style="display:none;">
                            <div class="ip-title" style="justify-content:space-between;">
                                <span style="display:flex;align-items:center;gap:8px;"><span class="badge"></span> 首次配置（必填）</span>
                                <button class="btn btn-primary btn-sm" onclick="saveRelayIP()">保存并启动</button>
                            </div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv6</span>
                                <input class="ip-edit" autocomplete="off" id="setup-ipv6" type="text" placeholder="例如：2001:db8::1（必填）">
                            </div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv4</span>
                                <input class="ip-edit" autocomplete="off" id="setup-ipv4" type="text" placeholder="例如：1.2.3.4（可选）">
                            </div>
                            <div class="relay-setup-hint">⚠ 必须先配置 IPv6 地址才能启动中继服务</div>
                        </div>
                        <!-- Edit form (hidden by default) -->
                        <div class="relay-ip-panel" id="relay-ip-edit" style="display:none;">
                            <div class="ip-title"><span class="badge"></span> 修改地址</div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv6</span>
                                <input class="ip-edit" autocomplete="off" id="edit-ipv6" type="text">
                            </div>
                            <div class="relay-ip-row">
                                <span class="ip-label">IPv4</span>
                                <input class="ip-edit" autocomplete="off" id="edit-ipv4" type="text">
                            </div>
                            <div class="relay-ip-actions">
                                <button class="btn btn-primary btn-sm" onclick="saveRelayIP()">保存</button>
                                <button class="btn btn-ghost btn-sm" onclick="cancelEditIP()">取消</button>
                            </div>
                        </div>
                        <!-- Port Pool -->
                        <div class="panel" style="margin-bottom:0;">
                            <div class="panel-head"><h3>端口池使用</h3><span class="view-sub" id="port-pool-range">40000 – 41000</span></div>
                            <div class="panel-body">
                                <div class="progress-wrap">
                                    <div class="progress-label"><span>已用端口</span><span id="port-pool-text">0 / 1001</span></div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" id="port-pool-bar" style="width:0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Control Connections -->
                    <div class="panel">
                        <div class="panel-head"><h3>控制连接</h3><span class="view-sub">房主 ↔ 中继的 TLS-PSK 常驻连接</span></div>
                        <div class="panel-body" id="control-conns">
                            <div class="empty" style="padding:30px 20px;">
                                <span style="font-size:12.5px;">暂无控制连接，等待房主端接入</span>
                            </div>
                        </div>
                    </div>

                    <!-- Data Tunnels -->
                    <div class="panel">
                        <div class="panel-head"><h3>数据隧道</h3><span class="view-sub">玩家 ↔ 中继 ↔ 房主的字节转发通道</span></div>
                        <div class="panel-body" id="data-tunnels">
                            <div class="empty" style="padding:30px 20px;">
                                <span style="font-size:12.5px;">暂无活跃隧道</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== 房间管理 ===== -->
            <div class="view" id="view-rooms">
                <div class="view-head">
                    <div>
                        <div class="view-title">房间管理</div>
                        <div class="view-sub">所有联机房间 · 连接码 · 玩家列表</div>
                    </div>
                    <div class="view-head-spacer"></div>
                    <button class="btn btn-primary" onclick="openCreateRoomModal()">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                        创建房间
                    </button>
                </div>
                <div class="scroll">
                    <div class="list-grid" id="room-grid">
                        <div class="create-card" onclick="openCreateRoomModal()">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            <span id="room-create-label">创建房间</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== 房间详情 ===== -->
            <div class="view" id="view-room-detail">
                <div class="view-head">
                    <button class="back-btn" id="detail-back">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div>
                        <div class="view-title" id="detail-title">未选择</div>
                        <div class="view-sub" id="detail-sub">请从房间列表进入</div>
                    </div>
                </div>
                <div class="scroll">
                    <div class="detail-hero">
                        <div class="detail-hero-top">
                            <div class="tag-row" style="margin-top:0;" id="detail-tags">
                                <span class="pill on">运行中</span>
                            </div>
                            <div style="display:flex;gap:8px;">
                                <button class="btn btn-ghost btn-sm" id="btn-copy-code">
                                    <svg viewBox="0 0 24 24" fill="none"><rect x="8" y="4" width="12" height="16" rx="1.5" stroke="currentColor" stroke-width="1.8"/><path d="M4 8v12a1.5 1.5 0 001.5 1.5H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                                    复制连接码
                                </button>
                                <button class="btn btn-danger btn-sm" id="btn-close-room">关闭房间</button>
                            </div>
                        </div>
                        <div class="detail-addr" id="detail-addr">—</div>
                    </div>
                    <div class="tabs">
                        <div class="tab active" data-tab="players">玩家列表</div>
                        <div class="tab" data-tab="info">房间信息</div>
                        <div class="tab" data-tab="tunnels">隧道状态</div>
                    </div>
                    <!-- Players Tab -->
                    <div class="tab-panel" id="tab-players">
                        <div class="panel">
                            <div class="panel-body">
                                <table class="kv-table">
                                    <thead><tr><th>玩家 ID</th><th>连接时间</th><th>已发送</th><th>已接收</th></tr></thead>
                                    <tbody id="player-table-body">
                                        <tr><td colspan="4" style="text-align:center;color:var(--text-tertiary);padding:20px;">暂无玩家连接</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- Info Tab -->
                    <div class="tab-panel" id="tab-info" style="display:none;">
                        <div class="panel">
