        document.getElementById('rinfo-port').textContent = room.assignedPort;
        document.getElementById('rinfo-mcport').textContent = room.localMcPort;
        document.getElementById('rinfo-status').textContent = room.status === 'active' ? '活跃' : room.status === 'waiting' ? '等待中' : '已关闭';
        document.getElementById('rinfo-players').textContent = room.playerCount;
        document.getElementById('rinfo-time').textContent = room.createdAt;

